+#pragma once
+
+#include "llama.h"
+
+#include <cstddef>
+
+struct llama_tokenization_cancelled {};
+
+struct llama_tokenize_abort {
+    llama_tokenize_abort_callback callback;
+    void * data;
+    size_t work[8] = {};
+
+    llama_tokenize_abort(llama_tokenize_abort_callback callback, void * data) : callback(callback), data(data) {}
+
+    void check(llama_tokenize_stage stage, bool force = false) {
+        if ((force || (work[stage]++ & 63) == 0) && callback && callback(stage, data)) {
+            throw llama_tokenization_cancelled{};
+        }
+    }
+};
