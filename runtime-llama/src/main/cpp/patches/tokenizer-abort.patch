+llama_tokenize_status llama_vocab::tokenize_with_abort(
+                  const char * text,
+                     int32_t   text_len,
+                 llama_token * tokens,
+                     int32_t   n_tokens_max,
+                        bool   add_special,
+                        bool   parse_special,
+        llama_tokenize_abort_callback abort_callback,
+                        void * abort_callback_data,
+                     int32_t * n_tokens) const {
+    if (!n_tokens) { return LLAMA_TOKENIZE_INVALID_ARGUMENT; }
+    *n_tokens = 0;
+    if (text_len < 0 || n_tokens_max < 0 || (!text && text_len) || (!tokens && n_tokens_max) || parse_special) {
+        return LLAMA_TOKENIZE_INVALID_ARGUMENT;
+    }
+    if (get_type() != LLAMA_VOCAB_TYPE_BPE || get_pre_type() != LLAMA_VOCAB_PRE_TYPE_QWEN2 ||
+            get_tokenizer_model() != "gpt2" || get_escape_whitespaces()) {
+        return LLAMA_TOKENIZE_UNSUPPORTED;
+    }
+    try {
+        llama_tokenize_abort abort(abort_callback, abort_callback_data);
+        abort.check(LLAMA_TOKENIZE_STAGE_INPUT, true);
+        if (!llama_tokenize_valid_utf8(text, static_cast<size_t>(text_len), abort)) {
+            return LLAMA_TOKENIZE_INVALID_UTF8;
+        }
+        std::string input;
+        for (size_t offset = 0; offset < static_cast<size_t>(text_len);) {
+            abort.check(LLAMA_TOKENIZE_STAGE_INPUT);
+            const auto length = std::min(size_t(1024), static_cast<size_t>(text_len) - offset);
+            input.append(text + offset, length);
+            offset += length;
+        }
+        auto result = pimpl->tokenize(input, add_special, false, &abort);
+        abort.check(LLAMA_TOKENIZE_STAGE_OUTPUT, true);
+        if (result.size() > static_cast<size_t>(std::numeric_limits<int32_t>::max())) {
+            return LLAMA_TOKENIZE_OVERFLOW;
+        }
+        *n_tokens = static_cast<int32_t>(result.size());
+        if (*n_tokens > n_tokens_max) { return LLAMA_TOKENIZE_BUFFER_TOO_SMALL; }
+        if (!result.empty()) { std::copy(result.begin(), result.end(), tokens); }
+        return LLAMA_TOKENIZE_OK;
+    } catch (const llama_tokenization_cancelled &) {
+        return LLAMA_TOKENIZE_CANCELLED;
+    } catch (...) {
+        return LLAMA_TOKENIZE_FAILED;
+    }
+}
