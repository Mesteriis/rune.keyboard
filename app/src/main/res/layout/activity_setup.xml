<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/setup_page_padding"
      android:paddingTop="32dp"
      android:paddingEnd="@dimen/setup_page_padding"
      android:paddingBottom="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/setup_title"
        android:textColor="@color/setup_text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/setup_description"
        android:textColor="@color/setup_text_secondary"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/setup_section_spacing"
        android:background="@drawable/setup_card_background"
        android:orientation="vertical"
        android:padding="@dimen/setup_card_padding">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/setup_status_label"
          android:textColor="@color/setup_text_secondary"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/keyboard_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="@string/setup_status_disabled"
          android:textColor="@color/status_disabled"
          android:textSize="22sp"
          android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/setup_card_background"
        android:orientation="vertical"
        android:padding="@dimen/setup_card_padding">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/setup_enable_title"
          android:textColor="@color/setup_text_primary"
          android:textSize="20sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:lineSpacingExtra="2dp"
          android:text="@string/setup_enable_description"
          android:textColor="@color/setup_text_secondary"
          android:textSize="15sp" />

      <Button
          android:id="@+id/enable_keyboard_button"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:minHeight="48dp"
          android:text="@string/setup_enable_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/setup_card_background"
        android:orientation="vertical"
        android:padding="@dimen/setup_card_padding">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/setup_select_title"
          android:textColor="@color/setup_text_primary"
          android:textSize="20sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:lineSpacingExtra="2dp"
          android:text="@string/setup_select_description"
          android:textColor="@color/setup_text_secondary"
          android:textSize="15sp" />

      <Button
          android:id="@+id/select_keyboard_button"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:minHeight="48dp"
          android:text="@string/setup_select_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/setup_card_background"
        android:orientation="vertical"
        android:padding="@dimen/setup_card_padding">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/setup_privacy_title"
          android:textColor="@color/setup_text_primary"
          android:textSize="20sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:lineSpacingExtra="2dp"
          android:text="@string/setup_privacy_description"
          android:textColor="@color/setup_text_secondary"
          android:textSize="15sp" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:lineSpacingExtra="2dp"
          android:text="@string/setup_mvp_note"
          android:textColor="@color/setup_text_secondary"
          android:textSize="14sp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
