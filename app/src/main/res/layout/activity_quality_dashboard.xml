<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quality_scroll" android:layout_width="match_parent"
    android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/setup_page_padding"
        android:paddingEnd="@dimen/setup_page_padding" android:paddingTop="24dp" android:paddingBottom="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/quality_dashboard_intro" android:textColor="@color/setup_text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/quality_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="@color/setup_text_primary" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/quality_actions_title" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/setup_text_primary" android:accessibilityHeading="true" tools:targetApi="28" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/quality_actions_note" android:textColor="@color/setup_text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/quality_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:lineSpacingExtra="8dp" android:textColor="@color/setup_text_primary" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/quality_latency_title" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/setup_text_primary" android:accessibilityHeading="true" tools:targetApi="28" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/quality_latency_note" android:textColor="@color/setup_text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/quality_latency" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:lineSpacingExtra="8dp" android:textColor="@color/setup_text_primary" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/quality_shadow_title" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/setup_text_primary" android:accessibilityHeading="true" tools:targetApi="28" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/quality_shadow_note" android:textColor="@color/setup_text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/quality_shadow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:lineSpacingExtra="8dp" android:textColor="@color/setup_text_primary" android:textSize="16sp" />
        <Button android:id="@+id/quality_refresh" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="24dp" android:text="@string/quality_refresh" />
        <Button android:id="@+id/quality_reset" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/quality_reset" />
    </LinearLayout>
</ScrollView>
