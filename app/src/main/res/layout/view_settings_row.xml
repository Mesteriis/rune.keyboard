<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/settings_row_padding"
    android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/setup_text_primary"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/row_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/setup_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
  </LinearLayout>

  <CheckBox
      android:id="@+id/row_checkbox"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:clickable="false"
      android:focusable="false"
      android:minWidth="48dp"
      android:minHeight="48dp"
      android:visibility="gone" />
</LinearLayout>
