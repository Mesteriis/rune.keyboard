    <string name="quality_storage_ready">Ready</string>
    <string name="quality_storage_resetting">Resetting; collection paused</string>
    <string name="quality_storage_failed">Unavailable; collection paused. Reset to retry.</string>
    <string name="quality_actions_title">Acknowledged actions</string>
    <string name="quality_actions_note">Automatic changes are unlabelled decisions. No undo does not mean a correction was right. Explicit choices express user preference, not independently verified accuracy.</string>
    <string name="quality_automatic_applied">Automatic corrections applied</string>
    <string name="quality_explicit_undo">Explicit correction undos</string>
    <string name="quality_correction_picked">Correction candidates picked</string>
    <string name="quality_kept_original">Original spellings explicitly kept</string>
    <string name="quality_boundary_picked">Word boundary suggestions picked</string>
    <string name="quality_abbreviation_picked">Abbreviations expanded</string>
    <string name="quality_phrase_picked">Phrase reviews applied</string>
    <string name="quality_latency_title">Candidate response time</string>
    <string name="quality_latency_note">Time from a candidate request to its accepted response. This excludes screen rendering and is not end-to-end keystroke latency.</string>
    <string-array name="quality_latency_labels">
        <item>Under 5 ms</item><item>5 to under 10 ms</item><item>10 to under 25 ms</item>
        <item>25 to under 50 ms</item><item>50 to under 100 ms</item><item>100 ms or more</item>
    </string-array>
    <string name="quality_shadow_title">Shadow algorithm comparison</string>
    <string name="quality_shadow_note">Primary: the normal qualified decision. Experimental: the strongest explicit personal preference, otherwise the top ranked candidate before automatic qualification. Both use the same candidates. The experiment never changes text. Agreement is not proof of correctness; matches below count only explicit user choices.</string>
    <string name="quality_shadow_agreement">Decisions that agreed</string>
    <string name="quality_shadow_disagreement">Decisions that differed</string>
    <string name="quality_shadow_primary">Explicit choice matched primary only</string>
    <string name="quality_shadow_experimental">Explicit choice matched experimental only</string>
    <string name="quality_shadow_both">Explicit choice matched both</string>
    <string name="quality_shadow_neither">Explicit choice matched neither</string>
