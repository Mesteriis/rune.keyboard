<resources>
    <string name="quality_dashboard_title">Local typing quality</string>
    <string name="quality_dashboard_intro">Numeric totals stay on this device and are excluded from backups. No typed text is saved in these metrics. Collection requires the corresponding tool to be enabled and an eligible editor.</string>
    <string name="quality_enabled">On</string>
    <string name="quality_disabled">Off</string>
    <string name="quality_status_format">Quality metrics: %1$s\nShadow comparison: %2$s\nStorage: %3$s</string>
