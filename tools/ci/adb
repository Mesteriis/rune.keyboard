#!/bin/sh

set -u

sdk_root="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-/usr/local/lib/android/sdk}}"
real_adb="$sdk_root/platform-tools/adb-real"

if [ ! -x "$real_adb" ]; then
    echo "Pinned adb binary is unavailable: $real_adb" >&2
    exit 127
fi

# The API 37 preview image currently crashes SurfaceFlinger when SystemUI
# registers its luma-sampling listener against gfxstream's
# ReadColorBufferDMA capability. Disable SystemUI as soon as PackageManager is
# available in that one headless matrix job; app, IME, and runtime
# instrumentation do not depend on status/navigation chrome.
if [ "${1:-}" = "-s" ] \
    && [ "${3:-}" = "shell" ] \
    && [ "${4:-}" = "getprop" ] \
    && [ "${5:-}" = "sys.boot_completed" ]; then
    marker="${RUNNER_TEMP:-/tmp}/rune-api37-systemui-disabled"
    if [ ! -e "$marker" ]; then
        api_level=$("$real_adb" -s "${2:-}" shell getprop ro.build.version.sdk 2>/dev/null || true)
        if [ "$api_level" = "37" ]; then
            if "$real_adb" -s "${2:-}" shell pm disable-user --user 0 com.android.systemui \
                >/dev/null 2>&1; then
                : > "$marker"
            fi
        fi
    fi
fi

# android-emulator-runner unlocks the device immediately after
# sys.boot_completed becomes 1. On preview API images the input service can
# still need a few seconds before accepting that one key event.
if [ "${1:-}" = "-s" ] \
    && [ "${3:-}" = "shell" ] \
    && [ "${4:-}" = "input" ] \
    && [ "${5:-}" = "keyevent" ] \
    && [ "${6:-}" = "82" ]; then
    attempt=1
    while [ "$attempt" -le 15 ]; do
        if "$real_adb" "$@"; then
            exit 0
        fi
        if [ "$attempt" -lt 15 ]; then
            sleep 2
        fi
        attempt=$((attempt + 1))
    done
    exit 1
fi

exec "$real_adb" "$@"
