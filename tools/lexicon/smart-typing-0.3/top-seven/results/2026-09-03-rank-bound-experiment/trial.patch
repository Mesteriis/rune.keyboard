--- a/app/src/test/java/io/github/mesteriis/rune/keyboard/smarttyping/lexicon/PackedLexiconValidationTest.kt
+++ b/app/src/test/java/io/github/mesteriis/rune/keyboard/smarttyping/lexicon/PackedLexiconValidationTest.kt
@@ -11,0 +12,25 @@ class PackedLexiconValidationTest {
+    @Test fun `frequency lower bounds include own terminal descendants and unranked branches`() {
+        val ranks = mapOf("a" to 30, "aa" to 40, "ab" to 2, "abc" to 50_000,
+            "b" to Int.MAX_VALUE, "ba" to Int.MAX_VALUE, "é" to 65_535, "ё" to 65_534,
+            "😀" to 90_000, "😀a" to Int.MAX_VALUE)
+        val fixture = PackedFixture.build(ranks.keys.toList())
+        fixture.words.forEachIndexed { i, word -> fixture.put(fixture.ranks, 20 + 4 * i, ranks.getValue(word)) }
+        val loaded = fixture.load(fixture.trusted(maximumFrequencyRank = 100_000)) as PackedLexiconLoad.Ready
+        val data = loaded.lexicon
+        var count = 0
+        fun visit(node: Int, prefix: String) {
+            val expected = ranks.filterKeys { it.startsWith(prefix) }.values.min()
+            val bound = data.minimumRank(node)
+            assertEquals(if (expected == Int.MAX_VALUE) expected else minOf(expected, 65_534), bound)
+            assertTrue(bound <= expected)
+            count++
+            var child = data.child(node)
+            while (child != 0) {
+                visit(child, prefix + String(Character.toChars(data.label(child))))
+                child = data.sibling(child)
+            }
+        }
+        visit(0, "")
+        assertEquals(data.nodeCount, count)
+    }
+
