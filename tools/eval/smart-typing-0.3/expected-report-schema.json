{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared-candidate suitability report",
  "type": "object",
  "required": [
    "version",
    "scope",
    "identity",
    "frozenConfigSha256",
    "limitations",
    "splits",
    "allScoresPresent",
    "preparedCandidateRowGatePass",
    "productionQualified"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "scope": {
      "const": "prepared-candidate synthetic stress suitability only"
    },
    "identity": {
      "type": "object",
      "required": [
        "protocol",
        "corpusSha256",
        "runnerSha256",
        "modelSha256"
      ],
      "properties": {
        "protocol": {
          "const": "rune-score-jsonl-v1"
        },
        "corpusSha256": {
          "$ref": "#/$defs/sha"
        },
        "runnerSha256": {
          "$ref": "#/$defs/sha"
        },
        "modelSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "frozenConfigSha256": {
      "$ref": "#/$defs/sha"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "splits": {
      "type": "object",
      "required": [
        "calibration",
        "holdout"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "ru",
          "en",
          "es"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/metrics"
        }
      }
    },
    "allScoresPresent": {
      "type": "boolean"
    },
    "preparedCandidateRowGatePass": {
      "type": "boolean"
    },
    "productionQualified": {
      "const": false
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rate": {
      "type": "object",
      "required": [
        "numerator",
        "denominator",
        "value",
        "wilson95RowDescriptive"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "wilson95RowDescriptive": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "automaticReplacements",
        "precision",
        "falseChange",
        "falseChangeByCohort",
        "typoCorrectionCoverage",
        "top1Typo",
        "punctuationSuggestionTop1Unambiguous",
        "punctuationAmbiguousCount",
        "punctuationAutomaticReplacements",
        "rejectedOrMissingScores",
        "runtimeErrors",
        "missingScores",
        "wordFamilies",
        "contextTemplates",
        "automaticReplacementFamilies",
        "falsePositiveIds",
        "passesRowGate",
        "abstentionAllSpelling",
        "preparedOracleCandidateRecall"
      ],
      "properties": {
        "automaticReplacements": {
          "type": "integer",
          "minimum": 0
        },
        "precision": {
          "$ref": "#/$defs/rate"
        },
        "falseChange": {
          "$ref": "#/$defs/rate"
        },
        "typoCorrectionCoverage": {
          "$ref": "#/$defs/rate"
        },
        "top1Typo": {
          "$ref": "#/$defs/rate"
        },
        "punctuationSuggestionTop1Unambiguous": {
          "$ref": "#/$defs/rate"
        },
        "punctuationAutomaticReplacements": {
          "const": 0
        },
        "passesRowGate": {
          "type": "boolean"
        },
        "falsePositiveIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstentionAllSpelling": {
          "$ref": "#/$defs/rate",
          "description": "All spelling rows without an automatic replacement / all spelling rows, including policy, rejected and missing-score rows."
        },
        "preparedOracleCandidateRecall": {
          "$ref": "#/$defs/rate",
          "description": "Typo rows whose authored expectedSpelling occurs in the prepared candidates / all typo rows. Oracle-injected containment, not production candidate-generator or ranking recall."
        }
      }
    }
  }
}
