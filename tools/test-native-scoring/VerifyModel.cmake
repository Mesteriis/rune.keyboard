function(verify_scoring_model path)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Supply the reviewed GGUF as an existing local file")
    endif()
    file(SIZE "${path}" size)
    file(SHA256 "${path}" sha)
    if(NOT size EQUAL 396704416 OR NOT sha STREQUAL "7a97111c917e19117207428971fa1c2583f2d9c2a07a6fda5b6f198b707dd9c4")
        message(FATAL_ERROR "GGUF size/SHA256 does not match the reviewed Rune artifact")
    endif()
endfunction()
